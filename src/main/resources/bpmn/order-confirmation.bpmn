      <bpmndi:BPMNShape id="Shape_Confirm" bpmnElement="TaskConfirmOrder" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1171" y="99" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reject" bpmnElement="TaskRejectOrder" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="1227" y="208" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CompensateReservation" bpmnElement="EventCompensateReservation">
        <dc:Bounds x="1137" y="230" width="36" height="36" />
