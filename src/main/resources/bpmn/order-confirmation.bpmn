          <dc:Bounds x="1113" y="271" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Reservation_Compensation" bpmnElement="AssociationReservationCompensation">
        <di:waypoint x="365" y="248" />
        <di:waypoint x="365" y="283" />
