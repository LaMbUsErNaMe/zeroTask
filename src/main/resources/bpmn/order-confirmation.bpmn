<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_OrderConfirmation" targetNamespace="http://example.com/zero/order-confirmation" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:message id="Message_OrderConfirmationResult" name="orderConfirmationResultMessage" />
  <bpmn:collaboration id="Collaboration_1mj5jyp">
    <bpmn:participant id="Participant_1htyte1" name="Подтверждение заказа" processRef="order-confirmation" />
  </bpmn:collaboration>
  <bpmn:process id="order-confirmation" name="Подтверждение заказа" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:sequenceFlow id="FlowStartPending" sourceRef="StartEventConfirmRequested" targetRef="TaskMarkConfirmationPending" />
    <bpmn:sequenceFlow id="FlowPendingValidate" sourceRef="TaskMarkConfirmationPending" targetRef="TaskValidateOrder" />
    <bpmn:sequenceFlow id="FlowValidateValidGateway" sourceRef="TaskValidateOrder" targetRef="GatewayOrderValid" />
    <bpmn:sequenceFlow id="FlowRequestWait" sourceRef="TaskRequestConfirmation" targetRef="EventWaitConfirmationResult" />
    <bpmn:sequenceFlow id="FlowWaitResultGateway" sourceRef="EventWaitConfirmationResult" targetRef="GatewayConfirmationResult" />
    <bpmn:sequenceFlow id="FlowResultConfirm" name="Да" sourceRef="GatewayConfirmationResult" targetRef="TaskConfirmOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${expressionHelper.confirmationSuccessful(execution)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FlowConfirmEnd" sourceRef="TaskConfirmOrder" targetRef="EndEventCompleted" />
    <bpmn:sequenceFlow id="Flow_Result_Reject" name="Нет" sourceRef="GatewayConfirmationResult" targetRef="EventCompensateReservation" />
    <bpmn:sequenceFlow id="FlowInvalidReject" name="Нет" sourceRef="GatewayOrderValid" targetRef="EventCompensateReservation" />
    <bpmn:sequenceFlow id="FlowRejectEnd" sourceRef="TaskRejectOrder" targetRef="EndEventCompleted" />
    <bpmn:sequenceFlow id="FlowValidRequest" name="Да" sourceRef="GatewayOrderValid" targetRef="TaskRequestConfirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${expressionHelper.orderValid(execution)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="TaskMarkConfirmationPending" name="Зафиксировать резерв" camunda:delegateExpression="${markConfirmationPendingDelegate}">
      <bpmn:incoming>FlowStartPending</bpmn:incoming>
      <bpmn:outgoing>FlowPendingValidate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GatewayOrderValid" name="Заказ прошёл проверку?" default="FlowInvalidReject">
      <bpmn:incoming>FlowValidateValidGateway</bpmn:incoming>
      <bpmn:outgoing>FlowValidRequest</bpmn:outgoing>
      <bpmn:outgoing>FlowInvalidReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TaskValidateOrder" name="Проверить заказ" camunda:delegateExpression="${validateOrderDelegate}">
      <bpmn:incoming>FlowPendingValidate</bpmn:incoming>
      <bpmn:outgoing>FlowValidateValidGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryReservationCompensation" attachedToRef="TaskMarkConfirmationPending">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:startEvent id="StartEventConfirmRequested" name="Получен запрос">
      <bpmn:outgoing>FlowStartPending</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="TaskRequestConfirmation" name="Запросить подтверждение" camunda:asyncBefore="true" camunda:delegateExpression="${requestConfirmationDelegate}">
      <bpmn:incoming>FlowValidRequest</bpmn:incoming>
      <bpmn:outgoing>FlowRequestWait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="FlowCompensationReject" sourceRef="EventCompensateReservation" targetRef="TaskRejectOrder" />
    <bpmn:serviceTask id="TaskReleaseReservation" name="Вернуть товары" isForCompensation="true" camunda:delegateExpression="${releaseReservationDelegate}" />
    <bpmn:intermediateCatchEvent id="EventWaitConfirmationResult" name="Ожидать результат">
      <bpmn:incoming>FlowRequestWait</bpmn:incoming>
      <bpmn:outgoing>FlowWaitResultGateway</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_OrderConfirmationResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GatewayConfirmationResult" name="Подтверждено?" default="Flow_Result_Reject">
      <bpmn:incoming>FlowWaitResultGateway</bpmn:incoming>
      <bpmn:outgoing>FlowResultConfirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_Result_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEventCompleted" name="Процесс завершён">
      <bpmn:incoming>FlowConfirmEnd</bpmn:incoming>
      <bpmn:incoming>FlowRejectEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TaskConfirmOrder" name="Подтвердить заказ" camunda:asyncBefore="true" camunda:delegateExpression="${confirmOrderDelegate}">
      <bpmn:incoming>FlowResultConfirm</bpmn:incoming>
      <bpmn:outgoing>FlowConfirmEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TaskRejectOrder" name="Отклонить заказ" camunda:asyncBefore="true" camunda:delegateExpression="${rejectOrderDelegate}">
      <bpmn:incoming>FlowCompensationReject</bpmn:incoming>
      <bpmn:outgoing>FlowRejectEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="EventCompensateReservation" name="Компенсировать резерв">
      <bpmn:incoming>FlowInvalidReject</bpmn:incoming>
      <bpmn:incoming>Flow_Result_Reject</bpmn:incoming>
      <bpmn:outgoing>FlowCompensationReject</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:association id="AssociationReservationCompensation" associationDirection="One" sourceRef="BoundaryReservationCompensation" targetRef="TaskReleaseReservation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderConfirmation">
    <bpmndi:BPMNPlane id="BPMNPlane_OrderConfirmation" bpmnElement="Collaboration_1mj5jyp">
      <bpmndi:BPMNShape id="Participant_1htyte1_di" bpmnElement="Participant_1htyte1" isHorizontal="true">
        <dc:Bounds x="130" y="70" width="1340" height="280" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pending" bpmnElement="TaskMarkConfirmationPending">
        <dc:Bounds x="310" y="150" width="110" height="80" />
