<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="DefinitionsOrderConfirmation" targetNamespace="http://example.com/zero/order-confirmation" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:error id="ErrorOrderConfirmation" name="Order confirmation error" errorCode="ORDER_CONFIRMATION_ERROR" />
  <bpmn:message id="MessageComplianceResult" name="complianceResultMessage" />
  <bpmn:collaboration id="Collaboration0z08txd">
    <bpmn:participant id="Participant19gq1uq" name="подтверждение заказа" processRef="OrderConfirmation" />
  </bpmn:collaboration>
  <bpmn:process id="OrderConfirmation" name="Order confirmation" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEventOrderReceived">
      <bpmn:outgoing>FlowStartRequestCompliance</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="TaskRequestCompliance" name="Compliance" camunda:asyncBefore="true" camunda:delegateExpression="${requestComplianceDelegate}">
      <bpmn:incoming>FlowStartRequestCompliance</bpmn:incoming>
      <bpmn:outgoing>Flow1dqi2pe</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event0oh6ifv">
      <bpmn:incoming>Flow0mbilcc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway1bs5gri">
      <bpmn:incoming>Flow0pbwihq</bpmn:incoming>
      <bpmn:incoming>Flow0n44lio</bpmn:incoming>
      <bpmn:outgoing>Flow0mbilcc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="TaskNotifyComplianceRejected" name="уведомление об отклонении заявки" camunda:asyncBefore="true" camunda:exclusive="false" camunda:delegateExpression="${notifyRejectedDelegate}">
      <bpmn:incoming>Flow1f6d6rm</bpmn:incoming>
      <bpmn:outgoing>Flow0n44lio</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TaskRejectComplianceOrder" name="Изменение статуса на REJECTED" camunda:asyncBefore="true" camunda:exclusive="false" camunda:delegateExpression="${rejectOrderDelegate}">
      <bpmn:incoming>Flow0cphbgc</bpmn:incoming>
      <bpmn:outgoing>Flow0pbwihq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TaskRegisterContract" name="заключение договора" camunda:asyncBefore="true" camunda:delegateExpression="${registerContractDelegate}">
      <bpmn:incoming>Flow1dqi2pe</bpmn:incoming>
      <bpmn:outgoing>FlowContractJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TaskCancelContract" name="отмена договора" isForCompensation="true" camunda:asyncBefore="true" camunda:delegateExpression="${cancelContractDelegate}" />
    <bpmn:exclusiveGateway id="Gateway0g7xdf3" default="Flow1kmdlce">
      <bpmn:incoming>Flow11av0b9</bpmn:incoming>
      <bpmn:outgoing>Flow1bpdpue</bpmn:outgoing>
      <bpmn:outgoing>Flow1kmdlce</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event0bp6pqg">
      <bpmn:incoming>FlowContractJoin</bpmn:incoming>
      <bpmn:outgoing>Flow11av0b9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition0d2q1s0" messageRef="MessageComplianceResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway0x3g58j">
      <bpmn:incoming>Flow1bpdpue</bpmn:incoming>
      <bpmn:outgoing>Flow0cphbgc</bpmn:outgoing>
      <bpmn:outgoing>Flow1f6d6rm</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEventConfirmed">
      <bpmn:incoming>Flow0m2zqcx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TaskCompleteOrder" name="Изменение статуса CONFIRMED | CANCELED" camunda:asyncBefore="true" camunda:exclusive="false" camunda:delegateExpression="${updateOrderStatusDelegate}">
      <bpmn:incoming>Flow107qp3l</bpmn:incoming>
      <bpmn:outgoing>Flow0m2zqcx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="Gateway1i1i6rl">
      <bpmn:incoming>Flow1rxh337</bpmn:incoming>
      <bpmn:outgoing>Flow0mut60r</bpmn:outgoing>
      <bpmn:outgoing>Flow107qp3l</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="TaskRollbackPayment" name="отмена оплаты" isForCompensation="true" camunda:asyncBefore="true" camunda:delegateExpression="${rollbackPaymentDelegate}" />
    <bpmn:serviceTask id="TaskPayOrder" name="оплата" camunda:asyncBefore="true" camunda:delegateExpression="${payOrderDelegate}">
      <bpmn:incoming>Flow048a04j</bpmn:incoming>
      <bpmn:outgoing>Flow1rxh337</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TaskCancelDelivery" name="отмена доставки" isForCompensation="true" camunda:asyncBefore="true" camunda:delegateExpression="${cancelDeliveryDelegate}" />
    <bpmn:serviceTask id="TaskRegisterDelivery" name="оформление доставки" camunda:asyncBefore="true" camunda:delegateExpression="${registerDeliveryDelegate}">
      <bpmn:incoming>Flow1kmdlce</bpmn:incoming>
      <bpmn:outgoing>Flow048a04j</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryContractCompensation" attachedToRef="TaskRegisterContract">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryPaymentCompensation" attachedToRef="TaskPayOrder">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryDeliveryCompensation" attachedToRef="TaskRegisterDelivery">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="FlowStartRequestCompliance" sourceRef="StartEventOrderReceived" targetRef="TaskRequestCompliance" />
    <bpmn:sequenceFlow id="Flow1dqi2pe" sourceRef="TaskRequestCompliance" targetRef="TaskRegisterContract" />
    <bpmn:sequenceFlow id="Flow0mbilcc" sourceRef="Gateway1bs5gri" targetRef="Event0oh6ifv" />
    <bpmn:sequenceFlow id="Flow0pbwihq" sourceRef="TaskRejectComplianceOrder" targetRef="Gateway1bs5gri" />
    <bpmn:sequenceFlow id="Flow0n44lio" sourceRef="TaskNotifyComplianceRejected" targetRef="Gateway1bs5gri" />
    <bpmn:sequenceFlow id="Flow1f6d6rm" sourceRef="Gateway0x3g58j" targetRef="TaskNotifyComplianceRejected" />
    <bpmn:sequenceFlow id="Flow0cphbgc" sourceRef="Gateway0x3g58j" targetRef="TaskRejectComplianceOrder" />
    <bpmn:sequenceFlow id="FlowContractJoin" sourceRef="TaskRegisterContract" targetRef="Event0bp6pqg" />
    <bpmn:sequenceFlow id="Flow11av0b9" sourceRef="Event0bp6pqg" targetRef="Gateway0g7xdf3" />
    <bpmn:sequenceFlow id="Flow1bpdpue" sourceRef="Gateway0g7xdf3" targetRef="Gateway0x3g58j">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complianceSuccess == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow1kmdlce" sourceRef="Gateway0g7xdf3" targetRef="TaskRegisterDelivery" />
    <bpmn:sequenceFlow id="Flow0m2zqcx" sourceRef="TaskCompleteOrder" targetRef="EndEventConfirmed" />
    <bpmn:sequenceFlow id="Flow107qp3l" sourceRef="Gateway1i1i6rl" targetRef="TaskCompleteOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow0mut60r" sourceRef="Gateway1i1i6rl" targetRef="GatewayRejectionFork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorFlag == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow1rxh337" sourceRef="TaskPayOrder" targetRef="Gateway1i1i6rl" />
    <bpmn:sequenceFlow id="Flow048a04j" sourceRef="TaskRegisterDelivery" targetRef="TaskPayOrder" />
    <bpmn:endEvent id="Event1dh305l">
      <bpmn:incoming>Flow1sbhs7y</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="GatewayRejectionJoin">
      <bpmn:incoming>FlowRejectionNotificationJoin</bpmn:incoming>
      <bpmn:incoming>Flow00t7pay</bpmn:incoming>
      <bpmn:outgoing>Flow1sbhs7y</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="TaskNotifyRejected" name="уведомление об отклонении заказа" camunda:asyncBefore="true" camunda:exclusive="false" camunda:delegateExpression="${notifyRejectedDelegate}">
      <bpmn:incoming>FlowNotifyRejected</bpmn:incoming>
      <bpmn:outgoing>FlowRejectionNotificationJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TaskReleaseReservation" name="вернуть товары" camunda:asyncBefore="true" camunda:exclusive="false" camunda:delegateExpression="${releaseReservationDelegate}">
      <bpmn:incoming>FlowReleaseReservation</bpmn:incoming>
      <bpmn:outgoing>Flow00t7pay</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GatewayRejectionFork">
      <bpmn:incoming>Flow0mut60r</bpmn:incoming>
      <bpmn:outgoing>FlowReleaseReservation</bpmn:outgoing>
      <bpmn:outgoing>FlowNotifyRejected</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow1sbhs7y" sourceRef="GatewayRejectionJoin" targetRef="Event1dh305l" />
    <bpmn:sequenceFlow id="Flow00t7pay" sourceRef="TaskReleaseReservation" targetRef="GatewayRejectionJoin" />
    <bpmn:sequenceFlow id="FlowRejectionNotificationJoin" sourceRef="TaskNotifyRejected" targetRef="GatewayRejectionJoin" />
    <bpmn:sequenceFlow id="FlowNotifyRejected" sourceRef="GatewayRejectionFork" targetRef="TaskNotifyRejected" />
    <bpmn:sequenceFlow id="FlowReleaseReservation" sourceRef="GatewayRejectionFork" targetRef="TaskReleaseReservation" />
    <bpmn:subProcess id="EventSubProcessErrorHandler" name="event handaler" triggeredByEvent="true">
      <bpmn:startEvent id="StartEventOrderError">
        <bpmn:outgoing>FlowErrorCompensate</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="ErrorOrderConfirmation" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="FlowErrorCompensate" sourceRef="StartEventOrderError" targetRef="EventCompensate" />
      <bpmn:intermediateThrowEvent id="EventCompensate">
        <bpmn:incoming>FlowErrorCompensate</bpmn:incoming>
        <bpmn:outgoing>FlowErrorSetFlag</bpmn:outgoing>
        <bpmn:compensateEventDefinition />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="FlowErrorSetFlag" sourceRef="EventCompensate" targetRef="ScriptTaskSetErrorFlag" />
      <bpmn:scriptTask id="ScriptTaskSetErrorFlag" name="Set error flag" camunda:asyncBefore="true" scriptFormat="groovy">
        <bpmn:incoming>FlowErrorSetFlag</bpmn:incoming>
        <bpmn:outgoing>FlowErrorReturn</bpmn:outgoing>
        <bpmn:script>execution.setVariable("errorFlag", true)</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="FlowErrorReturn" sourceRef="ScriptTaskSetErrorFlag" targetRef="TaskReturnToResult" />
      <bpmn:serviceTask id="TaskReturnToResult" name="Return" camunda:asyncBefore="true" camunda:delegateExpression="${returnToResultDelegate}">
        <bpmn:incoming>FlowErrorReturn</bpmn:incoming>
        <bpmn:outgoing>FlowErrorHandledEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="FlowErrorHandledEnd" sourceRef="TaskReturnToResult" targetRef="EndEventErrorHandled" />
      <bpmn:endEvent id="EndEventErrorHandled" camunda:asyncBefore="true">
        <bpmn:incoming>FlowErrorHandledEnd</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:association id="AssociationCancelContract" sourceRef="BoundaryContractCompensation" targetRef="TaskCancelContract" />
    <bpmn:association id="AssociationRollbackPayment" sourceRef="BoundaryPaymentCompensation" targetRef="TaskRollbackPayment" />
    <bpmn:association id="AssociationCancelDelivery" sourceRef="BoundaryDeliveryCompensation" targetRef="TaskCancelDelivery" />
  </bpmn:process>
